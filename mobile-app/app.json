{
  "expo": {
    "name": "ExpertLine Mobile",
    "slug": "expertline-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "uz.expertline.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "uz.expertline.mobile",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Chat fonini sozlash uchun galereyadan rasm tanlash.",
        "NSCameraUsageDescription": "Video aloqa uchun kamera kerak.",
        "NSMicrophoneUsageDescription": "Ovozli muloqot uchun mikrofon kerak."
      }
    },
    "plugins": []
  }
}
